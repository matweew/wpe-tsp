+// From drm_fourcc.h, for builds without libdrm.
+static constexpr uint32_t ionBufferFormat = 0x34325241; // DRM_FORMAT_ARGB8888, fourcc 'AR24'
+static constexpr uint64_t ionBufferModifier = 0x00ffffffffffffffULL; // DRM_FORMAT_MOD_INVALID
