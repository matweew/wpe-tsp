+// ION uAPI: the legacy interface (kernels <= 4.11, allocations return a handle that is then
+// shared as a DMA-buf fd) and the current one (allocations return the fd directly).
+struct IONAllocationDataLegacy {
+    size_t len;
+    size_t align;
+    unsigned heapIDMask;
+    unsigned flags;
+    int handle;
+};
+struct IONFdData {
+    int handle;
+    int fd;
+};
+struct IONHandleData {
+    int handle;
+};
+struct IONAllocationData {
+    uint64_t len;
+    uint32_t heapIDMask;
+    uint32_t flags;
+    uint32_t fd;
+    uint32_t unused;
+};
+#define WEBKIT_ION_IOC_ALLOC_LEGACY _IOWR('I', 0, struct IONAllocationDataLegacy)
+#define WEBKIT_ION_IOC_FREE_LEGACY _IOWR('I', 1, struct IONHandleData)
+#define WEBKIT_ION_IOC_SHARE_LEGACY _IOWR('I', 4, struct IONFdData)
+#define WEBKIT_ION_IOC_ALLOC _IOWR('I', 0, struct IONAllocationData)
+
+static int ionDevice()
+{
+    static int device = [] {
+        auto& extensions = PlatformDisplay::sharedDisplay().eglExtensions();
+        if (!getenv("WEBKIT_DMABUF_ION") || !extensions.EXT_image_dma_buf_import)
+            return -1;
+        return open("/dev/ion", O_RDWR | O_CLOEXEC);
+    }();
+    return device;
+}
+
+static UnixFileDescriptor ionAllocate(size_t length)
+{
+    unsigned heapMask = strtoul(getenv("WEBKIT_DMABUF_ION"), nullptr, 0);
+    if (!heapMask)
+        heapMask = 1;
+
+    IONAllocationDataLegacy legacy = { length, 4096, heapMask, 0, 0 };
+    if (!ioctl(ionDevice(), WEBKIT_ION_IOC_ALLOC_LEGACY, &legacy)) {
+        IONFdData share = { legacy.handle, -1 };
+        int result = ioctl(ionDevice(), WEBKIT_ION_IOC_SHARE_LEGACY, &share);
+        // The DMA-buf keeps the memory alive after the handle is gone.
+        IONHandleData handle = { legacy.handle };
+        ioctl(ionDevice(), WEBKIT_ION_IOC_FREE_LEGACY, &handle);
+        return UnixFileDescriptor(result ? -1 : share.fd, UnixFileDescriptor::Adopt);
+    }
