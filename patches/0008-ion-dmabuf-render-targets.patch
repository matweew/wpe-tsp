+    IONAllocationData data = { length, heapMask, 0, 0, 0 };
+    if (!ioctl(ionDevice(), WEBKIT_ION_IOC_ALLOC, &data))
+        return UnixFileDescriptor(static_cast<int>(data.fd), UnixFileDescriptor::Adopt);
+    return { };
+}
+
+bool AcceleratedSurface::RenderTargetION::isAvailable()
+{
+    return ionDevice() >= 0;
