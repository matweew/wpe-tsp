+std::unique_ptr<AcceleratedSurface::RenderTarget> AcceleratedSurface::RenderTargetION::create(AcceleratedSurface& surface, const IntSize& size)
+{
+    // GPUs want aligned rows (the PowerVR GE8300 rejects e.g. 1279 * 4 bytes): pad to 32 pixels.
+    uint32_t stride = ((size.width() + 31) & ~31) * 4;
+    auto fd = ionAllocate(static_cast<size_t>(stride) * size.height());
+    if (!fd) {
+        WTFLogAlways("Failed to allocate ION buffer of size %dx%d: %s", size.width(), size.height(), safeStrerror(errno).data());
+        return nullptr;
+    }
+
+    DMABufBufferAttributes attributes;
+    attributes.size = size;
+    attributes.fourcc = ionBufferFormat;
+    attributes.fds.append(WTF::move(fd));
+    attributes.offsets.append(0);
+    attributes.strides.append(stride);
+    attributes.modifier = ionBufferModifier;
+
+    // No modifier: the buffer is linear, which is what the driver assumes without one.
+    Vector<EGLAttrib> imageAttributes {
+        EGL_WIDTH, size.width(),
+        EGL_HEIGHT, size.height(),
+        EGL_LINUX_DRM_FOURCC_EXT, ionBufferFormat,
+        EGL_DMA_BUF_PLANE0_FD_EXT, attributes.fds[0].value(),
+        EGL_DMA_BUF_PLANE0_OFFSET_EXT, 0,
+        EGL_DMA_BUF_PLANE0_PITCH_EXT, stride,
+        EGL_NONE
+    };
+    auto image = PlatformDisplay::sharedDisplay().createEGLImage(EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, imageAttributes);
+    if (!image) {
+        WTFLogAlways("Failed to create EGL image for ION buffer of size %dx%d", size.width(), size.height());
+        return nullptr;
+    }
+
+    return makeUnique<RenderTargetION>(surface, size, image, WTF::move(attributes));
+}
+
+AcceleratedSurface::RenderTargetION::RenderTargetION(AcceleratedSurface& surface, const IntSize& size, EGLImage image, DMABufBufferAttributes&& attributes)
+    : RenderTargetShareableBuffer(surface, size)
+    , m_image(image)
+{
+    // Texture rather than renderbuffer storage: the path the PowerVR driver is known to support.
+    glGenTextures(1, &m_texture);
+    glBindTexture(GL_TEXTURE_2D, m_texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, m_image);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_texture, 0);
+    if (m_surface->useSkia())
+        createSkiaSurfaceForFramebuffer(m_fbo);
+
+    WebProcess::singleton().parentProcessConnection()->send(Messages::AcceleratedBackingStore::DidCreateDMABufBuffer(m_id, WTF::move(attributes), RendererBufferFormat::Usage::Rendering), m_surface->surfaceID());
+}
