+// I420/YV12/NV12/NV21 in system memory (software decoders): upload each plane into a one- or two-
+// channel texture (R8, RG8: OpenGL ES 3) and draw them with the YUV shader, as for GStreamer GL frames.
+bool CoordinatedPlatformLayerBufferVideo::createBufferFromMappedYUVFrame()
+{
+    auto* info = m_mappedVideoFrame->info();
+    auto gstFormat = GST_VIDEO_INFO_FORMAT(info);
+    if (gstFormat != GST_VIDEO_FORMAT_I420 && gstFormat != GST_VIDEO_FORMAT_YV12 && gstFormat != GST_VIDEO_FORMAT_NV12 && gstFormat != GST_VIDEO_FORMAT_NV21)
+        return false;
+    auto* context = GLContext::current();
+    if (!context || context->version() < 300)
+        return false;
+    auto format = yuvFormatFromGstVideoFormat(gstFormat);
+    if (!format)
+        return false;
+
+    unsigned numberOfPlanes = GST_VIDEO_INFO_N_PLANES(info);
+    glGenTextures(numberOfPlanes, m_planeTextures.data());
+    m_planeTextureCount = numberOfPlanes;
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    for (unsigned plane = 0; plane < numberOfPlanes; ++plane) {
+        // The plane's first component gives its size; two components (NV12/NV21 chroma) interleave
+        unsigned component = 0;
+        unsigned components = 0;
+        for (unsigned c = 0; c < GST_VIDEO_INFO_N_COMPONENTS(info); ++c) {
+            if (GST_VIDEO_INFO_COMP_PLANE(info, c) != plane)
+                continue;
+            if (!components)
+                component = c;
+            ++components;
+        }
+        int width = GST_VIDEO_INFO_COMP_WIDTH(info, component);
+        int height = GST_VIDEO_INFO_COMP_HEIGHT(info, component);
+        bool twoChannels = components == 2;
+        int stride = m_mappedVideoFrame->planeStride(plane);
+        glBindTexture(GL_TEXTURE_2D, m_planeTextures[plane]);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, stride / (twoChannels ? 2 : 1));
+        glTexImage2D(GL_TEXTURE_2D, 0, twoChannels ? GL_RG8 : GL_R8, width, height, 0, twoChannels ? GL_RG : GL_RED,
+            GL_UNSIGNED_BYTE, m_mappedVideoFrame->planeData(plane).data());
+    }
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    glBindTexture(GL_TEXTURE_2D, 0);
+
+    std::array<unsigned, 4> yuvPlane;
+    std::array<unsigned, 4> yuvPlaneOffset;
+    for (unsigned i = 0; i < numberOfPlanes; ++i) {
+        yuvPlane[i] = m_mappedVideoFrame->componentPlane(i);
+        yuvPlaneOffset[i] = m_mappedVideoFrame->componentPlaneOffset(i);
+    }
+    auto [yuvToRgbColorSpace, transferFunction] = yuvColorSpaceFromVideoInfo(*info);
+    std::array<unsigned, 4> planes = m_planeTextures;
+    m_buffer = CoordinatedPlatformLayerBufferYUV::create(*format, numberOfPlanes, WTF::move(planes), WTF::move(yuvPlane), WTF::move(yuvPlaneOffset),
+        yuvToRgbColorSpace, transferFunction, m_size, m_flags, nullptr);
+    m_mappedVideoFrame = std::nullopt;
+    return true;
+}
